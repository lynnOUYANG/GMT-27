{
  "protocol": "fixed_hyperparameters_five_full_repeats",
  "methods": [
    "gin",
    "gcn",
    "gat",
    "gqt",
    "vqgraph",
    "nodeid",
    "mole_bert"
  ],
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "datasets": {
    "molhiv": {
      "config": "configs/frozen_node_motif512_molhiv.json",
      "split_manifest": "data/molhiv/manifest.json"
    },
    "molbace": {
      "config": "configs/frozen_node_motif512_molbace.json",
      "split_manifest": "data/molbace/manifest.json"
    },
    "zinc": {
      "config": "configs/frozen_node_motif512_zinc.json",
      "split_manifest": "data/zinc/manifest.json"
    },
    "molesol": {
      "config": "configs/frozen_node_motif512_molesol.json",
      "split_manifest": "data/molesol/manifest.json"
    },
    "qm9_12": {
      "config": "configs/frozen_node_motif512_qm9_12.json",
      "split_manifest": "data/qm9_12_std/manifest.json"
    },
    "sider": {
      "config": "configs/frozen_node_motif512_sider.json",
      "split_manifest": "data/sider/manifest.json"
    },
    "tox21": {
      "config": "configs/frozen_node_motif512_tox21.json",
      "split_manifest": "data/tox21/manifest.json"
    },
    "aqsol": {
      "config": "configs/frozen_node_motif512_aqsol.json",
      "split_manifest": "data/aqsol/manifest.json"
    },
    "qm8": {
      "config": "configs/frozen_node_motif512_qm8.json",
